{
  "schema_version": "1.0",
  "id": "calculator",
  "name": "Calculator",
  "version": "0.1.0",
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "adapter": {
    "kind": "native-api",
    "name": "Self-owned calculator methods"
  },
  "commands": [
    {
      "name": "add",
      "description": "Add two bounded integers using the local calculator method.",
      "input_schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "b": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "side_effect": "read_only"
    },
    {
      "name": "subtract",
      "description": "Subtract b from a using the local calculator method.",
      "input_schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "b": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "side_effect": "read_only"
    },
    {
      "name": "multiply",
      "description": "Multiply two bounded integers using the local calculator method.",
      "input_schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "b": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "side_effect": "read_only"
    }
  ]
}
