{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-cli.dev/schemas/app-manifest.schema.json",
  "title": "App-CLI application manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "platforms", "adapter", "commands"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "maxLength": 64},
    "platforms": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["windows", "macos", "linux", "android", "ios"]}
    },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["native-api", "http-api", "cli", "ipc", "scripting", "browser", "accessibility", "ui-test", "instrumentation", "frida", "file", "vision", "runtime"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "commands": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "description", "input_schema", "output_schema", "side_effect"],
        "properties": {
          "name": {"$ref": "#/$defs/identifier"},
          "description": {"type": "string", "minLength": 1, "maxLength": 2000},
          "input_schema": {"type": ["object", "boolean"]},
          "output_schema": {"type": ["object", "boolean"]},
          "side_effect": {"enum": ["read_only", "local_mutation", "remote_mutation"]}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 64}
  }
}
